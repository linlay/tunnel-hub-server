# Build-time module identity. Real repository-specific values belong in the
# ignored .env file or CI variables; committed Go sources use a neutral path.
GO_MODULE_PATH=example.invalid/tunnel-hub-server

# Comma-separated terms rejected by make verify-neutral. Keep the real list in
# the ignored .env file and in CI variables.
FORBIDDEN_BRAND_TERMS=

# Runtime identity and public routing. Production values belong in .env.
BRAND_ID=example
PRODUCT_NAME=Example Desktop
PUBLIC_SITE_TITLE=Example Desktop
PUBLIC_BASE_DOMAIN=hub.example.test
DESKTOP_PUBLIC_BASE_DOMAIN=m.example.test
WEBAPP_PUBLIC_BASE_DOMAIN=wa.example.test
RELAY_PUBLIC_URL=ws://127.0.0.1:11961/tunnel
SHARE_PUBLIC_BASE_URL=http://127.0.0.1:11961

# Relay listen address for local Go runs.
RELAY_ADDR=:11961

AGENT_RELAY_URL=ws://127.0.0.1:11961/tunnel

# Local Go runs use a project-local SQLite database.
# docker-compose.yml overrides this to /data/tunnel.db inside the container.
RELAY_DB_PATH=tunnel.db

# Legacy static website hosting. Leave empty for the split website/server deployment.
ADMIN_HOST=
WEBSITE_DIST=
# Local admin login for the management website. Only set ADMIN_PASSWORD when you
# want to bootstrap the first local admin user.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SESSION_TTL=24h
COOKIE_SECURE=false
MOBILE_WEBAPP_COOKIE_SECURE=true

# Official-site SSO JWT verifier. Required for official JWT admin access and Desktop registration APIs.
SSO_JWT_ISSUER=
SSO_JWT_PUBLIC_KEY_FILE=configs/jwt-public.pem
SSO_JWT_PUBLIC_KEY_PEM=
SSO_JWT_AUDIENCE=tunnel
SSO_JWT_USER_ID_CLAIM=sub
# Dangerous compatibility switches. Keep false unless the trusted issuer cannot
# mint Tunnel Hub-specific audience, role, or scope claims.
SSO_JWT_ALLOW_ANY_AUDIENCE=false
SSO_JWT_ALLOW_ANY_ADMIN_ROLE=false
SSO_JWT_ALLOW_MISSING_TUNNEL_SCOPE=false

# Maximum buffered HTTP request body size, in bytes.
MAX_REQUEST_BODY_BYTES=67108864

# Desktop public mini site HTTP port. Reverse proxy should send ordinary
# Device hosts use the public site, while configured device subdomains and WebSocket upgrades stay on the relay.
TUNNEL_HUB_PUBLIC_PORT=11965

# Trusted reverse proxy CIDRs for reading X-Real-IP / X-Forwarded-For.
# Production Docker + nginx deployments usually use:
# TRUSTED_PROXY_CIDRS=172.23.0.1/32,127.0.0.1/32,::1/128
TRUSTED_PROXY_CIDRS=
