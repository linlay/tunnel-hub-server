# Replace every uppercase brace-delimited placeholder before loading this template.
{
	email {{ACME_EMAIL}}
}

{{PUBLIC_BASE}} {
	handle /api/admin* {
		reverse_proxy relay:8080
	}

	handle /api/desktop* {
		reverse_proxy relay:8080
	}

	handle /api/upload {
		respond 404
	}

	handle /api/resource {
		respond 404
	}

	handle /api/download {
		respond 404
	}

	handle /api/download/* {
		respond 404
	}

	handle /api/pull/* {
		reverse_proxy relay:8080
	}

	handle /api/push/* {
		reverse_proxy relay:8080
	}

	handle /assets/conversation-export/* {
		reverse_proxy relay:8080
	}

	handle /tunnel {
		reverse_proxy relay:8080
	}

	handle {
		reverse_proxy website:80
	}
}

{{SHARE_HOST}} {
	handle /assets/conversation-export/* {
		reverse_proxy relay:8080
	}

	handle /share/* {
		reverse_proxy relay:8080
	}

	handle {
		respond 404
	}
}

# Public wildcard routes require DNS for *.{{DESKTOP_PUBLIC_BASE}} and *.{{WEBAPP_PUBLIC_BASE}}.
# WebApp hosts use the single-label form <id>-wa.{{WEBAPP_PUBLIC_BASE}}.
# Public ACME wildcard certificates usually require a DNS challenge provider.
*.{{DESKTOP_PUBLIC_BASE}} {
	@mobileWebApp host_regexp mobileWebApp ^[^.]+-[0-9]+\.{{DESKTOP_PUBLIC_BASE_REGEX}}$
	handle @mobileWebApp {
		reverse_proxy relay:8080
	}

	handle /api/upload {
		reverse_proxy relay:8080
	}

	handle /api/resource {
		reverse_proxy relay:8080
	}

	handle /api/pull/* {
		reverse_proxy relay:8080
	}

	handle /api/push/* {
		reverse_proxy relay:8080
	}

	handle /api/download {
		respond 404
	}

	handle /api/download/* {
		respond 404
	}

	@desktopWs {
		header Connection *Upgrade*
		header Upgrade websocket
	}
	handle @desktopWs {
		reverse_proxy relay:8080
	}
	handle {
		reverse_proxy public:80
	}
}

*.{{WEBAPP_PUBLIC_BASE}} {
	reverse_proxy relay:8080
}
